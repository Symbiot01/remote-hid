# Copy to ~/capture/.env or /etc/hid-capture.env (never commit real values).

# Slice C — live publish via SRT (UDP 8890). Campus Wi‑Fi may block; use WARP/VPN or unfiltered uplink.
SRT_URL=srt://mediarelay.sahilpatel.online:8890?streamid=publish:cam&pkt_size=1316
# Legacy WHIP URL (unused by publish_whip.sh until a WHIP client exists)
# WHIP_URL=https://mediarelay.sahilpatel.online:8889/cam/whip

# Slice E — outbound WSS to HID (no static Pi IP; same CAPTURE_TOKEN as Coolify HID)
RELAY_WS_URL=wss://webrelay.sahilpatel.online/ws/capture
# Generate: openssl rand -hex 24  — must match HID CAPTURE_TOKEN (≥16 chars)
CAPTURE_TOKEN=

# Still while SRT is live: briefly stop/start whip.service (needs sudoers — see sudoers/)
CAPTURE_RELEASE_WHIP=1
WHIP_SERVICE=whip.service
# Fast still size (full sensor is slow and can hit photo timeout)
# STILL_WIDTH=1280
# STILL_HEIGHT=720

# Slice D — optional local still HTTP for LAN/debug curl only (not used by Slice E WS)
# STILL_HOST=127.0.0.1
# STILL_PORT=8091

# Encode defaults (Slices B/C)
WIDTH=1280
HEIGHT=720
FPS=30
