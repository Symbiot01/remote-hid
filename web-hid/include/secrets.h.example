#pragma once

// Copy to secrets.h and fill in. secrets.h is gitignored.

// Wi-Fi (WPA2-PSK). For WPA2-Enterprise set WIFI_USE_ENTERPRISE 1 and fill username.
#ifndef WIFI_USE_ENTERPRISE
#define WIFI_USE_ENTERPRISE 0
#endif

static const char *WIFI_SSID = "YOUR_SSID";
static const char *WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

#if WIFI_USE_ENTERPRISE
static const char *WIFI_USERNAME = "YOUR_USERNAME";
#endif

// Desk LAN: host = operator PC IP, port 8080, TLS off (begin).
// Production: host = your domain, port 443, TLS on (beginSSL).
static const char *WS_HOST = "192.168.1.10";
static const int WS_PORT = 8080;
static const bool WS_USE_SSL = false;

// Must match DEVICE_TOKEN on the server (.env), min 16 chars.
static const char *DEVICE_TOKEN = "change-me-device-token";
