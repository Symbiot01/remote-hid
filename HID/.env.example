# Required. Shared UI gate password (min 16 characters). Never commit real values.
GATE_PASSWORD=

# Required. Random secret for signing session cookies (min 32 characters).
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Server bind. The Docker image sets PORT=3000 and HOST=0.0.0.0.
# Locally these defaults stay on the loopback.
PORT=8080
HOST=127.0.0.1

# development | production
NODE_ENV=development

# Set to 1 behind a reverse proxy so the login limiter sees the client IP
TRUST_PROXY=0

# MediaMTX playback. The browser reaches this only through the session proxy.
STREAM_WHEP_URL=http://127.0.0.1:8889/cam/whep

# Where the server publishes after it transcodes the bridge feed.
STREAM_SRT_URL=srt://127.0.0.1:8890?streamid=publish:cam&pkt_size=1316

# Bearer token for the bridge ingest. Generate: openssl rand -hex 32
# Leave empty to refuse ingest. Never commit a real value.
BRIDGE_TOKEN=

# LookCam device password. Sent only to the bridge over the bearer channel.
# Never commit a real value. The browser cannot read this.
LOOKCAM_PASSWORD=

# HID keyboard relay. Leave HID_URL empty until the relay is listening.
# The relay must use a different port from PORT above. DEVICE_TOKEN stays on the relay.
# The browser never sees HID_GATE_PASSWORD or the device token.
# HID_URL=http://127.0.0.1:8090
# HID_GATE_PASSWORD=

# Second camera. Empty CAPTURE_TOKEN refuses the capture agent.
# Generate: openssl rand -hex 32
# The browser never sees this token.
# CAPTURE_TOKEN=

# Where the capture agent is published after the server transcodes it.
# STREAM_DESK_SRT_URL=srt://127.0.0.1:8890?streamid=publish:desk&pkt_size=1316
# STREAM_DESK_WHEP_URL=http://127.0.0.1:8889/desk/whep

# LookCam stills are read from this RTSP URL. The live ingest is not stopped.
# CAPTURE_RTSP_CAM=rtsp://127.0.0.1:8554/cam
