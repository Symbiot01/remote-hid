# Required. Shared UI gate password (min 16 characters). Never commit real values.
GATE_PASSWORD=

# Required. Random secret for signing session cookies (min 32 characters).
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Required. Shared with ESP32 firmware /ws/device?token=… (min 16 characters).
DEVICE_TOKEN=

# Server bind (default 8080 for LAN desk tests)
PORT=8080
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Set to 1 behind a reverse proxy so client IPs are correct for rate limits
TRUST_PROXY=0

# Public MediaMTX HTTPS origin (CSP connect-src + Stream-test). Must match VITE_MEDIA_BASE_URL.
# MEDIA_BASE_URL=https://mediarelay.sahilpatel.online:8889
# MEDIA_STUN_URL=stun:stun.l.google.com:19302

# Slice E — Pi outbound WSS /ws/capture?token=… (same secret on Pi). No CAPTURE_URL / no Pi IP.
# Generate: openssl rand -hex 24 (≥16 chars). Browser never sees this.
# CAPTURE_TOKEN=
