{
  "name": "operator-console",
  "version": "0.1.0",
  "private": true,
  "description": "Password-gated operator console",
  "main": "src/index.js",
  "scripts": {
    "build": "npm --prefix web ci && npm --prefix web run build",
    "build:web": "npm --prefix web run build",
    "start": "node src/index.js",
    "dev:server": "node --watch src/index.js",
    "dev:web": "npm --prefix web run dev",
    "dev": "npx concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "test": "node --test src/camera.test.js src/hid.test.js src/capture.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "cookie-signature": "^1.2.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
